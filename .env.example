# ---------------------------------------------------------------------------
# Rafting Club Armenia — environment configuration example
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values are optional; the site builds and runs without them.
# ---------------------------------------------------------------------------

# Public site URL (used for canonicals, sitemap, hreflang, structured data).
NUXT_PUBLIC_SITE_URL=https://raftingclubarmenia.com

# Google Analytics 4 measurement ID. Leave empty to keep analytics disabled.
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: booking/contact form endpoint (e.g. a serverless function or a
# form-to-email provider such as Formspree/Web3Forms). Leave empty to keep the
# form in "no backend configured" mode (it will show a graceful fallback).
# NUXT_PUBLIC_CONTACT_ENDPOINT=
